# Shire Docker stack configuration. `./setup.sh` generates .env for you; copy this file to
# .env only if you're configuring by hand (docker compose reads .env automatically).

# REQUIRED — Fernet key encrypting stored git credentials at rest.
# Generate: openssl rand -base64 32 | tr '+/' '-_'
# Do NOT rotate once credentials are stored — they'd become undecryptable.
SHIRE_SECRET_KEY=

# --- Claude auth for agent jobs (pick ONE) ------------------------------------------------
# Option A: paid API key.
#ANTHROPIC_API_KEY=sk-ant-...
#USE_API_KEY=true

# Option B: Claude Pro/Max subscription token (run `claude setup-token` on your machine).
#CLAUDE_CODE_OAUTH_TOKEN=

# Option C: mount your host ~/.claude into the engine container (Linux hosts; on macOS the
# CLI stores credentials in the Keychain, so prefer option B there).
#COMPOSE_FILE=docker-compose.yml:docker-compose.claude.yml

# --- Optional ------------------------------------------------------------------------------
# Richer GitHub metadata, higher rate limits, private repo access.
#GITHUB_TOKEN=

# Model alias for agent runs: sonnet | opus | haiku (default sonnet).
#CLAUDE_MODEL=sonnet

# Concurrent jobs per engine instance (default 2).
#ENGINE_CONCURRENCY=2
