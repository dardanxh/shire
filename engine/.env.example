# Shire engine settings for NATIVE development (env prefix ENGINE_; the Docker stack is
# configured via the root .env instead). Copy to engine/.env and adjust.

# Plain psycopg DSN (no +psycopg driver suffix). Default matches be/docker-compose.yml.
ENGINE_DATABASE_URL=postgresql://shire:shire@localhost:5433/shire

# Path to the Claude Code CLI binary.
ENGINE_CLAUDE_BINARY=claude

# How many jobs this instance runs concurrently (each is a `claude -p` subprocess).
ENGINE_CONCURRENCY=2

# Auth: by default jobs run on the logged-in Claude subscription (ANTHROPIC_API_KEY is
# stripped from job envs). Set true to pass the key through for paid API auth.
#ENGINE_USE_API_KEY=false
