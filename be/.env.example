# Shire backend settings for NATIVE development (env prefix SHIRE_; the Docker stack is
# configured via the root .env instead). Copy to be/.env and adjust.

# Postgres DSN. Default matches be/docker-compose.yml (host port 5433).
#SHIRE_DATABASE_URL=postgresql+psycopg://shire:shire@localhost:5433/shire

# REQUIRED for storing git credentials — Fernet key used to encrypt them at rest.
# Generate: openssl rand -base64 32 | tr '+/' '-_'
# Do NOT rotate once credentials are stored — they'd become undecryptable.
SHIRE_SECRET_KEY=

# Where clones / graphs / artifacts / worktrees live (relative to be/ by default).
#SHIRE_CLONE_ROOT=.data/repos
#SHIRE_GRAPH_ROOT=.data/graph
#SHIRE_ARTIFACTS_ROOT=.data/artifacts
#SHIRE_WORKTREE_ROOT=.data/worktrees

# Optional GitHub token: richer metadata, higher rate limits, private repos.
#SHIRE_GITHUB_TOKEN=

# Claude Code CLI used for availability probes and agent defaults.
#SHIRE_CLAUDE_BINARY=claude
#SHIRE_CLAUDE_MODEL=sonnet
#SHIRE_CLAUDE_TIMEOUT_SECONDS=500

# Auth: by default runs use the logged-in Claude subscription (ANTHROPIC_API_KEY is stripped
# from run envs). Set true to pass the key through for paid API auth.
#SHIRE_USE_API_KEY=false

# Prefect orchestration (optional Phase 2.5 — see docs/running-phase-2.5.md).
#SHIRE_SCHEDULER_ENABLED=false
#SHIRE_PREFECT_API_URL=http://127.0.0.1:4200/api
#SHIRE_PREFECT_WORK_POOL=shire-pool
